    user = SG_SYSTEM()      # <-- the object is created here

    # --- Username ---
    user.username = input("Enter your username: ")
    print("Welcome, " + user.username)
    for _ in range(2):
        print("Running.....")
        print("Processing....")
    answer = input("Are you sure that username's correct? (yes/no): ").lower()
    if answer == 'yes':
        print("Username confirmed.")
    elif answer == 'no':
        print("Please restart the program and enter the correct username.")
