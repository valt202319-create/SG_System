import sys


class SG_SYSTEM:
    def __init__(self):
        self.username = ""
        self.password = ""
        self.phone = ""
        self.email = ""
        self.country = ""

    def show_info(self):
        print("Here is your user information...")
        print("Username: " + self.username)
        print("Phone number: " + self.phone)
        print("Email address: " + self.email)
        print("Country: " + self.country)
        print("Password: " + self.password)


